rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          "luc.cesbron@sdis53.fr",
          "formation@sdis53.fr"
        ];
    }

    function isAgentCalendarAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "luc.cesbron@sdis53.fr";
    }

    function isResourceManager() {
      let email = request.auth != null ? request.auth.token.email.lower() : "";
      let managerPath = /databases/$(database)/documents/resourceManagers/$(email);
      return request.auth != null
        && request.auth.token.email_verified == true
        && (
          email == "luc.cesbron@sdis53.fr"
          || (exists(managerPath) && get(managerPath).data.active == true)
        );
    }

    function isPrimaryResourceManager() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == "luc.cesbron@sdis53.fr";
    }

    function isValidResource() {
      return request.resource.data.keys().hasOnly([
        "name", "type", "immatriculation", "cis", "active", "notes",
        "createdBy", "createdAt", "updatedBy", "updatedAt"
      ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.type in ["vehicule", "autre"]
        && (!("immatriculation" in request.resource.data.keys()) || request.resource.data.immatriculation is string)
        && request.resource.data.cis is string
        && request.resource.data.cis.size() > 0
        && request.resource.data.cis.size() <= 100
        && request.resource.data.active is bool
        && (!("notes" in request.resource.data.keys()) || request.resource.data.notes is string);
    }

    function isValidResourceAssignment() {
      return request.resource.data.keys().hasOnly([
        "trainingId", "sessionId", "resourceId", "resourceIds", "startDate", "endDate",
        "temporaryResource", "temporaryResources", "temporaryName", "temporaryRegistration", "temporaryCis",
        "status", "notes", "contact", "createdBy", "createdAt", "updatedBy", "updatedAt"
      ])
        && request.resource.data.trainingId is string
        && request.resource.data.sessionId is string
        && (!("resourceId" in request.resource.data.keys()) || request.resource.data.resourceId is string)
        && (!("resourceIds" in request.resource.data.keys()) || request.resource.data.resourceIds is list)
        && (!("temporaryResource" in request.resource.data.keys()) || request.resource.data.temporaryResource is bool)
        && (!("temporaryResources" in request.resource.data.keys()) || request.resource.data.temporaryResources is list)
        && (!("temporaryName" in request.resource.data.keys()) || request.resource.data.temporaryName is string)
        && (!("temporaryRegistration" in request.resource.data.keys()) || request.resource.data.temporaryRegistration is string)
        && (!("temporaryCis" in request.resource.data.keys()) || request.resource.data.temporaryCis is string)
        && request.resource.data.startDate is string
        && request.resource.data.startDate.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches("[0-9]{4}-[0-9]{2}-[0-9]{2}")
        && request.resource.data.endDate >= request.resource.data.startDate
        && request.resource.data.status in ["planned", "confirmed", "cancelled"]
        && (!("notes" in request.resource.data.keys()) || request.resource.data.notes is string)
        && (!("contact" in request.resource.data.keys()) || request.resource.data.contact is string);
    }

    function isValidResourceRequest() {
      return request.resource.data.keys().hasOnly([
        "requesterUid", "requesterEmail", "trainingId", "sessionId",
        "startDate", "endDate", "resourceIds", "temporaryResources", "contact", "notes",
        "status", "assignedResourceIds", "createdAt", "updatedAt"
      ])
        && request.resource.data.requesterUid is string
        && request.resource.data.requesterEmail is string
        && request.resource.data.trainingId is string
        && request.resource.data.sessionId is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string
        && request.resource.data.status in ["pending", "accepted", "rejected"]
        && request.resource.data.resourceIds is list
        && request.resource.data.temporaryResources is list
        && (!("contact" in request.resource.data.keys()) || request.resource.data.contact is string)
        && (!("notes" in request.resource.data.keys()) || request.resource.data.notes is string)
        && (!("assignedResourceIds" in request.resource.data.keys()) || request.resource.data.assignedResourceIds is list);
    }

    function catalogueWritesAllowed() {
      let pointerPath = /databases/$(database)/documents/siteSettings/catalogue;
      let pointer = exists(pointerPath) ? get(pointerPath).data : {};
      let pointerAfter = existsAfter(pointerPath) ? getAfter(pointerPath).data : {};
      return !("publicationLockToken" in pointer)
        || !(pointer.publicationLockExpiresAt is timestamp)
        || pointer.publicationLockExpiresAt <= request.time
        || !("publicationLockToken" in pointerAfter);
    }

    function isValidAgentCalendarEntry() {
      return request.resource.data.keys().hasOnly(["firstName", "lastName", "status", "formateurCaisson", "icsUrl"])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 100
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 100
        && request.resource.data.status in ["SPP", "SPV"]
        && (!("formateurCaisson" in request.resource.data.keys()) || request.resource.data.formateurCaisson is bool)
        && request.resource.data.icsUrl is string
        && request.resource.data.icsUrl.size() <= 2048;
    }

    match /agentCalendars/{agentId} {
      allow read, delete: if isAgentCalendarAdmin();
      allow create, update: if isAgentCalendarAdmin() && isValidAgentCalendarEntry();
    }

    match /agentCalendarSync/{agentId} {
      allow read, delete: if isAgentCalendarAdmin();
    }

    match /agentOccupations/{occupationId} {
      allow read, delete: if isAgentCalendarAdmin();
    }

    match /resourceManagers/{managerEmail} {
      allow get: if isPrimaryResourceManager()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email.lower() == managerEmail);
      allow list: if isPrimaryResourceManager();
      allow create, update: if isPrimaryResourceManager()
        && request.resource.data.keys().hasOnly([
          "email", "displayName", "active", "createdBy", "createdAt", "updatedBy", "updatedAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == managerEmail
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.active is bool;
      allow delete: if isPrimaryResourceManager();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update: if isResourceManager() && isValidResource();
      allow delete: if isResourceManager();
    }

    match /resourceAssignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isResourceManager() && isValidResourceAssignment();
      allow delete: if isResourceManager();
    }

    match /resourceRequests/{requestId} {
      allow read: if isResourceManager()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.requesterUid == request.auth.uid);
      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.requesterUid == request.auth.uid
        && isValidResourceRequest();
      allow update: if isResourceManager()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.requesterUid == request.auth.uid
          && resource.data.status == "pending"
          && request.resource.data.status == "pending"
          && isValidResourceRequest());
      allow delete: if isResourceManager()
        || (request.auth != null
          && request.auth.token.email_verified == true
          && resource.data.requesterUid == request.auth.uid);
    }

    match /resourceAssignmentHistory/{historyId} {
      allow read: if isResourceManager();
      allow create: if isResourceManager()
        && request.resource.data.keys().hasOnly([
          "assignmentId", "action", "snapshot", "performedBy", "performedAt"
        ])
        && request.resource.data.assignmentId is string
        && request.resource.data.action in ["created", "updated", "cancelled", "deleted"]
        && request.resource.data.snapshot is map
        && request.resource.data.performedBy is string;
      allow update, delete: if false;
    }

    match /siteSettings/{settingId} {
      allow get: if settingId == "public" || (settingId == "catalogue" && isAdmin());
      allow create, update: if settingId == "public"
        && isAdmin()
        && request.resource.data.keys().hasOnly(["maintenance", "updatedAt"])
        && request.resource.data.maintenance is bool
        && request.resource.data.updatedAt is int;
      allow create, update: if settingId == "catalogue"
        && isAdmin()
        && request.resource.data.keys().hasOnly([
          "activeVersionId", "archiveId", "updatedAt", "restoredFromArchiveId", "restoredBy",
          "publicationLockToken", "publicationLockExpiresAt"
        ])
        && request.resource.data.activeVersionId is string
        && request.resource.data.updatedAt == request.time
        && (("publicationLockToken" in request.resource.data.keys())
          == ("publicationLockExpiresAt" in request.resource.data.keys()))
        && (!("publicationLockToken" in request.resource.data.keys())
          || (request.resource.data.publicationLockToken is string
            && request.resource.data.publicationLockExpiresAt is timestamp));
    }

    match /trainings/{trainingId} {
      allow read: if true;
      allow create, update: if isAdmin() && catalogueWritesAllowed()
        && (!("published" in request.resource.data.keys()) || request.resource.data.published is bool);
      allow delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /trainingCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /trainingLocations/{locationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /trainingContacts/{contactId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /importantInformation/{informationId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /importantInformationCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && catalogueWritesAllowed();
    }

    match /catalogVersions/{versionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == "creating"
        && request.resource.data.year is int
        && request.resource.data.year >= 2000
        && request.resource.data.year <= 2200
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.reviewLinkId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == "deleting";

      match /comments/{commentId} {
        allow read, write: if isAdmin();
      }

      match /records/{collectionName}/items/{recordId} {
        function versionCanBeEdited() {
          return isAdmin()
            && get(/databases/$(database)/documents/catalogVersions/$(versionId)).data.status
              in ["creating", "draft", "corrections_requested"];
        }

        allow read: if isAdmin();
        allow create, update: if versionCanBeEdited()
          && collectionName in [
            "trainings",
            "trainingCategories",
            "trainingLocations",
            "trainingContacts",
            "importantInformation",
            "importantInformationCategories"
          ];
        allow delete: if isAdmin()
          && get(/databases/$(database)/documents/catalogVersions/$(versionId)).data.status
          in ["creating", "draft", "corrections_requested", "deleting"]
          && collectionName in [
            "trainings",
            "trainingCategories",
            "trainingLocations",
            "trainingContacts",
            "importantInformation",
            "importantInformationCategories"
          ];
      }
    }

    match /catalogReviewLinks/{code} {
      allow get: if isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == "creating"
        && request.resource.data.versionId is string
        && request.resource.data.expiresAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == "deleting";

      match /comments/{commentId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /records/{collectionName}/items/{recordId} {
        allow read: if isAdmin();
        allow create, update: if isAdmin()
          && get(/databases/$(database)/documents/catalogReviewLinks/$(code)).data.status
            in ["creating", "draft", "corrections_requested"];
        allow delete: if isAdmin()
          && get(/databases/$(database)/documents/catalogReviewLinks/$(code)).data.status == "deleting";
      }
    }

    match /catalogArchives/{archiveId} {
      allow read, write: if isAdmin();

      match /records/{collectionName}/items/{recordId} {
        allow read, write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
